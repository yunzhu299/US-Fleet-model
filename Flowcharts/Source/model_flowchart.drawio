        </mxCell>
        <mxCell id="m6d" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#6A1B9A;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;Mineral Recovery&lt;/b&gt;&lt;br&gt;&lt;br&gt;Recyclable kWh × mineral intensity (kg/kWh)&lt;br&gt;× element-specific recovery rate:&lt;br&gt;&lt;br&gt;Ni, Co: 95% (hydro.)&lt;br&gt;Cu: 90% → 95% (post-2035)&lt;br&gt;Li: 0% → 80% (post-2035)&lt;br&gt;Mn: 0% → 95% (post-2035)&lt;br&gt;Graphite: 0% → 90% (post-2035)&lt;br&gt;&lt;br&gt;&lt;i&gt;2035 threshold reflects EU Battery&lt;br&gt;Regulation recovery mandates&lt;/i&gt;" vertex="1">

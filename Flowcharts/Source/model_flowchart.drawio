        <mxCell id="m6_constraint" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CE93D8;strokeColor=#6A1B9A;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;Recycling Facility Capacity Constraint&lt;/b&gt;&lt;br&gt;&lt;br&gt;Facilities have two sequential processing stages, each with independent capacity:&lt;br&gt;① &lt;b&gt;Black mass processing&lt;/b&gt; — disassembly, discharge, crushing → black powder&lt;br&gt;② &lt;b&gt;Refining&lt;/b&gt; — hydrometallurgy / pyrometallurgy → purified minerals&lt;br&gt;&lt;br&gt;&lt;b&gt;Effective capacity&lt;/b&gt; = min(Black mass cap, Refining cap)&lt;br&gt;&lt;b&gt;Available for post-consumer&lt;/b&gt; = Effective capacity − Scrap mass&lt;br&gt;&lt;b&gt;% Recyclable in NA&lt;/b&gt; = min(Available / EOL battery mass, 1)&lt;br&gt;&lt;br&gt;&lt;i&gt;Remainder is either exported as black mass (partially processed)&lt;br&gt;or exported as whole packs (unprocessed)&lt;/i&gt;" vertex="1">
          <mxGeometry height="195" width="480" x="310" y="970" as="geometry" />
        </mxCell>
        <mxCell id="e_a_con" edge="1" parent="1" source="s_a3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#6A1B9A;strokeWidth=1.5;fontSize=12;fontColor=#6A1B9A;" target="m6_constraint" value="EOL battery mass">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_b_con" edge="1" parent="1" source="s_b3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#6A1B9A;strokeWidth=1.5;fontSize=12;fontColor=#6A1B9A;" target="m6_constraint" value="scrap mass">
